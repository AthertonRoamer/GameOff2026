[gd_scene format=3]

[ext_resource type="Script" path="res://game/chat/chat_window.gd" id="1_chat"]

[node name="ChatWindow" type="PanelContainer"]
custom_minimum_size = Vector2(140, 72)
offset_right = 220.0
offset_bottom = 216.0
script = ExtResource("1_chat")

[node name="Box" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Header" type="HBoxContainer" parent="Box"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="GuardsTab" type="Button" parent="Box/Header"]
layout_mode = 2
size_flags_vertical = 4
mouse_default_cursor_shape = 2
text = "GUARDS"
flat = true

[node name="GuardsBubble" type="PanelContainer" parent="Box/Header"]
visible = false
layout_mode = 2
size_flags_vertical = 4

[node name="Count" type="Label" parent="Box/Header/GuardsBubble"]
layout_mode = 2
theme_override_font_sizes/font_size = 11
text = "0"
horizontal_alignment = 1

[node name="Gap" type="Control" parent="Box/Header"]
custom_minimum_size = Vector2(8, 0)
layout_mode = 2

[node name="IntrudersTab" type="Button" parent="Box/Header"]
layout_mode = 2
size_flags_vertical = 4
mouse_default_cursor_shape = 2
text = "INTRUDERS"
flat = true

[node name="IntrudersBubble" type="PanelContainer" parent="Box/Header"]
visible = false
layout_mode = 2
size_flags_vertical = 4

[node name="Count" type="Label" parent="Box/Header/IntrudersBubble"]
layout_mode = 2
theme_override_font_sizes/font_size = 11
text = "0"
horizontal_alignment = 1

[node name="Log" type="RichTextLabel" parent="Box"]
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 1
bbcode_enabled = true
scroll_following = true
autowrap_mode = 3

[node name="Input" type="LineEdit" parent="Box"]
layout_mode = 2
